
# What lnsd may start on its own, per medium. rnsd ignores this
# section. A file without it starts nothing automatically.
[auto]
  # An AutoInterface on the LAN when this file names none.
  lan = yes
  # Up to two servers of the shipped public list, left for the
  # network's own discovered ones once enough stand. A pinned list:
  # server_list = host:port, host:port
  servers = yes
  # BLE when an adapter is present, Columba-compatible.
  bluetooth = yes
  # LNodes by their USB strings, RNodes after a second of
  # silence and one detect request, on USB serial ports.
  serial = yes
