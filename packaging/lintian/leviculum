# musl-static binaries; see packaging/lintian/lblogd for the reasoning
# behind all three overrides. lnprobe joined the package after this file
# was first written and was missing from it until 2026-09-12 — with
# lintian absent from the verify host, nothing noticed.
leviculum: unstripped-binary-or-object [usr/bin/lncp]
leviculum: unstripped-binary-or-object [usr/bin/lnprobe]
leviculum: unstripped-binary-or-object [usr/bin/lnsd]
leviculum: unstripped-binary-or-object [usr/bin/lnstatus]
leviculum: unstripped-binary-or-object [usr/bin/lnstest]
leviculum: shared-library-lacks-prerequisites [usr/bin/lncp]
leviculum: shared-library-lacks-prerequisites [usr/bin/lnprobe]
leviculum: shared-library-lacks-prerequisites [usr/bin/lnsd]
leviculum: shared-library-lacks-prerequisites [usr/bin/lnstatus]
leviculum: shared-library-lacks-prerequisites [usr/bin/lnstest]
leviculum: statically-linked-binary [usr/bin/lncp]
leviculum: statically-linked-binary [usr/bin/lnprobe]
leviculum: statically-linked-binary [usr/bin/lnsd]
leviculum: statically-linked-binary [usr/bin/lnstatus]
leviculum: statically-linked-binary [usr/bin/lnstest]
