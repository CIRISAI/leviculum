<?xml version="1.0" encoding="utf-8"?>
<!-- The main views (1199): one top bar, the chat list or the map under
     it, the tab bar at the bottom. The bar is the overview's of 1130: our
     avatar with the status dot, the view's title, search and the menu. A
     sub view on this layout (the archive, the map from a chat) shows the
     back arrow in the avatar's place and no tab bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:visibility="gone" />

        <network.leviculum.loquax.AvatarView
            android:id="@+id/avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/tab_chats"
            android:textColor="@color/text"
            android:textSize="22sp" />

        <EditText
            android:id="@+id/query"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textColorHint="@color/text_secondary"
            android:textSize="18sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search"
            android:padding="12dp" />

        <ImageButton
            android:id="@+id/menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu"
            android:padding="12dp" />
    </LinearLayout>

    <!-- 1448, walk finding 14: the engine has no path to the mailbox; the
         list says so in words, not only by the avatar's grey dot. Text on
         the bar's ground, 15.4:1. -->
    <TextView
        android:id="@+id/offline_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bar"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="@string/offline_bar"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Chats: the list, its empty line, the pencil bottom right. -->
        <FrameLayout
            android:id="@+id/pane_chats"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Room at the bottom so the last row scrolls clear of the button. -->
            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@null"
                android:paddingBottom="88dp" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/no_conversations"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/write"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:background="@drawable/send_circle"
                android:contentDescription="@string/new_conversation"
                android:elevation="6dp"
                android:padding="16dp" />
        </FrameLayout>

        <!-- Map: the whole room, a chip at the top edge only while
             something happens, the credit at the bottom, the Friends
             button bottom right in the pencil's style with the crosshair
             above it (1201), a tapped friend's card at the bottom
             (MapPane, 1200), and the empty map's line and "Share my
             position" in the middle while nobody is on it (1201). -->
        <!-- The Browse tab's pane (1337): BrowsePane fills it in code. -->
        <FrameLayout
            android:id="@+id/pane_browse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- The Rooms (1384): Reticulum Relay Chat on the config's hub. -->
        <FrameLayout
            android:id="@+id/pane_rooms"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Explore's list (1578): ExplorePane fills it in code. -->
        <FrameLayout
            android:id="@+id/pane_explore"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/pane_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- The library's frame (MapView), added in code. -->
            <FrameLayout
                android:id="@+id/map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/chip"
                android:elevation="4dp"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/credit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:background="@drawable/chip"
                android:layout_margin="4dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/map_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="32dp"
                android:background="@drawable/panel_round"
                android:elevation="4dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/map_empty"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/map_share"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/share_position"
                    android:textAllCaps="false"
                    android:textColor="@color/accent"
                    android:textSize="16sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/locate"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="84dp"
                android:background="@drawable/send_circle"
                android:contentDescription="@string/locate"
                android:elevation="6dp"
                android:padding="16dp" />

            <ImageButton
                android:id="@+id/friends"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:background="@drawable/send_circle"
                android:contentDescription="@string/friends"
                android:elevation="6dp"
                android:padding="16dp" />

            <LinearLayout
                android:id="@+id/card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/sheet"
                android:clickable="true"
                android:elevation="8dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <network.leviculum.loquax.AvatarView
                        android:id="@+id/card_avatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/card_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/text"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/card_line"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- A node nearby that is no contact (1302): Add in
                         place of Chat and Share. -->
                    <Button
                        android:id="@+id/card_add"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nearby_add"
                        android:textAllCaps="false"
                        android:textColor="@color/accent"
                        android:textSize="16sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/card_chat"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/card_chat"
                        android:textAllCaps="false"
                        android:textColor="@color/accent"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/card_navigate"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/card_navigate"
                        android:textAllCaps="false"
                        android:textColor="@color/accent"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/card_share"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/card_share"
                        android:textAllCaps="false"
                        android:textColor="@color/accent"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- The tab bar: an icon with its label under it, the selected tab in
         the accent; the unread chats as a badge on Chats. -->
    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/background"
        android:elevation="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tab_chats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/tab_chats"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/tab_chats_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tab_chats_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/badge"
                    android:gravity="center"
                    android:minWidth="16dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/badge_text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tab_chats_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_chats"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_map"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/map"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tab_map_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tab_map_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Explore (1578): the pages and the public rooms under one
             button, the bar's third and last; the browser and a hub's
             rooms are opened from it. -->
        <LinearLayout
            android:id="@+id/tab_explore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/tab_explore"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tab_explore_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tab_explore_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_explore"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
