<?xml version="1.0" encoding="utf-8"?>
<!-- One conversation (1130): a large avatar; the name and up to two lines
     of the last message, ours with its delivery mark left of it as
     WhatsApp has it (1449, walk 1 finding 10); the time alone top right,
     and under it the unread count. Left of them the map pin (1224)
     when the peer's position is younger than a day: a glyph of 18dp in a
     tap target of 48dp, which opens the map on the peer; the rest of the
     row opens the chat. The row's vertical padding is the avatar's margin
     and the right column's, so the right column spans the row and the
     pin's 48dp stay inside it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <network.leviculum.loquax.AvatarView
        android:id="@+id/avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="18sp" />

        <!-- The mark of ours beside the last line, never under the time
             (1449, walk 1 finding 10: they overlapped). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/state_clock"
                android:tag="mark"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="1dp" />

            <TextView
                android:id="@+id/last"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 1452: "Zwei Kontakte heißen Lew" under a row whose name another
             peer shares; gone for every other row. -->
        <TextView
            android:id="@+id/same_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="italic"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="end"
        android:minWidth="48dp"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="12dp">

        <TextView
            android:id="@+id/at"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- The line under the time: the share sign, the pin, the count;
             below the time, never over it (1449). -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <!-- Our position share runs in this chat (1273): a small
                 crosshair in the accent colour, on our side. -->
            <TextView
                android:id="@+id/sharing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/sharing_sign"
                android:text="⌖"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/pin"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="-12dp"
                android:clickable="true"
                android:focusable="false"
                android:padding="15dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/unread"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@drawable/badge"
                android:gravity="center"
                android:minWidth="22dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/badge_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
