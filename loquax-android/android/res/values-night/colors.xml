<?xml version="1.0" encoding="utf-8"?>
<!-- The dark theme's colours, picked when the phone's dark setting is on;
     the names and the contrast rule of values/colors.xml. -->
<resources>
    <color name="background">#17181b</color>
    <!-- 15.0:1 and 7.7:1 on the background. -->
    <color name="text">#ececec</color>
    <color name="text_secondary">#a9abb0</color>
    <!-- 8.8:1 on the background. -->
    <color name="accent">#81c784</color>
    <!-- The top bar and the compose field: text 12.6:1, hint 6.5:1. -->
    <color name="bar">#26272b</color>
    <!-- Our bubble: body 6.2:1, time and the delivery mark 5.0:1. -->
    <color name="bubble_ours">#3b6b45</color>
    <color name="bubble_ours_text">#ffffff</color>
    <color name="bubble_ours_meta">#dbeadd</color>
    <!-- Theirs, a step lighter than the background: body 11.0:1, time 5.7:1. -->
    <color name="bubble_theirs">#303134</color>
    <color name="bubble_theirs_text">#ececec</color>
    <color name="bubble_theirs_meta">#a9abb0</color>
    <!-- The failed mark: its circle 4.8:1 on our bubble, the sign 7.2:1 on it. -->
    <color name="failed_ground">#ffdad6</color>
    <color name="failed_mark">#93000a</color>
    <!-- Read's two ticks on our bubble: 5.1:1; in the list the accent,
         8.8:1 on the background. -->
    <color name="read_mark">#b2ff59</color>
    <!-- The send button: 4.6:1 on the background, its arrow 3.9:1 on it. -->
    <color name="send">#4f8f5b</color>
    <color name="on_send">#ffffff</color>
    <!-- The unread count: 6.2:1. -->
    <color name="badge">#3b6b45</color>
    <color name="badge_text">#ffffff</color>
    <!-- The list's failed mark (1130): its circle 13.7:1 on the background,
         the sign 7.2:1 on it. -->
    <color name="list_failed_ground">#ffdad6</color>
    <color name="list_failed_mark">#93000a</color>
    <!-- The long press (1137): text 11.6:1 and delete 8.1:1 on the panels,
         our reaction's circle 3.6:1 on them. -->
    <color name="dim">#b3000000</color>
    <color name="panel">#2c2d31</color>
    <color name="failed_mark_on_panel">#ffb4ab</color>
    <color name="reaction_ours">#4f8f5b</color>
    <!-- A selected message's row: the accent at a quarter. -->
    <color name="selected_row">#4081c784</color>
    <!-- The status dot on the bar's avatar (1199), in a ring of the
         background: up and down, 8.8:1 and 4.5:1 on the background. The tab bar sits on the
         background: the selected tab in the accent, the others in
         text_secondary, and the map's chips are text on the bar. -->
    <color name="status_up">#81c784</color>
    <color name="status_down">#7d8087</color>
    <!-- The recording bar (1276): red 4.6:1 on the bar, the held
         microphone's white glyph 3.2:1 on it; amber 8.6:1 on the bar. -->
    <color name="rec_red">#ee6464</color>
    <color name="rec_amber">#ffb74d</color>
    <!-- A field's placeholder (1448, walk finding 4): lighter than any
         written text, so an empty field never reads as filled; 4.4:1 on the background,
         below text_secondary as a hint is meant to be. -->
    <color name="hint">#7c7f86</color>
    <!-- The own position on a map (1448): blue, as the maps people know
         draw it; 8.3:1 on the background. -->
    <color name="own_dot">#8ab4f8</color>
</resources>
