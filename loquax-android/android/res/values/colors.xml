<?xml version="1.0" encoding="utf-8"?>
<!-- The app's colours in the light theme; values-night/colors.xml holds the
     same names for the dark one. Every pair of text and its ground keeps a
     contrast of 4.5:1 or more (WCAG AA), a mark or a control 3:1 against
     what it sits on, the numbers beside each. The chat follows a modern
     messenger's layout (1129); ours stays in loquax's green, the accent. -->
<resources>
    <color name="background">#ffffff</color>
    <!-- 17.2:1 and 6.4:1 on the background. -->
    <color name="text">#1b1b1d</color>
    <color name="text_secondary">#5c5f66</color>
    <!-- Buttons, fields, the cursor and an unread time; 5.0:1 on the background. -->
    <color name="accent">#3a7d44</color>
    <!-- The chat's top bar and the compose field: text 15.4:1, hint 5.7:1. -->
    <color name="bar">#f1f2f4</color>
    <!-- Our bubble: body 6.4:1, time and the delivery mark 5.1:1. -->
    <color name="bubble_ours">#2e6b38</color>
    <color name="bubble_ours_text">#ffffff</color>
    <color name="bubble_ours_meta">#d6eadb</color>
    <!-- Theirs: body 14.3:1, time 5.9:1. -->
    <color name="bubble_theirs">#e9eaed</color>
    <color name="bubble_theirs_text">#1b1b1d</color>
    <color name="bubble_theirs_meta">#55585e</color>
    <!-- The failed mark: its circle 5.0:1 on our bubble, the sign 7.2:1 on it. -->
    <color name="failed_ground">#ffdad6</color>
    <color name="failed_mark">#93000a</color>
    <!-- Read's two ticks on our bubble (1232): the accent's family, 5.3:1
         on the bubble where the accent itself has 1.3:1. In the list read
         is the accent, 5.0:1 on the background. -->
    <color name="read_mark">#b2ff59</color>
    <!-- The send button: 6.4:1 on the background, its arrow 6.4:1 on it. -->
    <color name="send">#2e6b38</color>
    <color name="on_send">#ffffff</color>
    <!-- The unread count: 6.4:1. -->
    <color name="badge">#2e6b38</color>
    <color name="badge_text">#ffffff</color>
    <!-- The list's failed mark (1130): its circle 9.4:1 on the background,
         the sign 9.4:1 on it. -->
    <color name="list_failed_ground">#93000a</color>
    <color name="list_failed_mark">#ffffff</color>
    <!-- The long press (1137): the dim over the chat; the panels of the
         reactions and the actions, text 17.2:1 and delete 6.5:1 on them;
         our reaction's circle 3.3:1 on the panel. -->
    <color name="dim">#99000000</color>
    <color name="panel">#ffffff</color>
    <color name="failed_mark_on_panel">#ba1a1a</color>
    <color name="reaction_ours">#5f9a69</color>
    <!-- A selected message's row: the accent at a quarter over the
         background, under bubbles that keep their own contrast. -->
    <color name="selected_row">#403a7d44</color>
    <!-- The status dot on the bar's avatar (1199), in a ring of the
         background: up and down, 5.1:1 and 3.8:1 on the background. The tab bar sits on the
         background: the selected tab in the accent, the others in
         text_secondary, and the map's chips are text on the bar. -->
    <color name="status_up">#2e7d32</color>
    <color name="status_down">#80848c</color>
    <!-- The recording bar (1276): the dot, the held microphone (its white
         glyph 5.6:1 on it) and the armed hint, 5.0:1 on the bar; the
         timer in its last 30 s, 4.8:1 on the bar. -->
    <color name="rec_red">#c62828</color>
    <color name="rec_amber">#9a5b00</color>
    <!-- A field's placeholder (1448, walk finding 4): lighter than any
         written text, so an empty field never reads as filled; 3.3:1 on the background,
         below text_secondary as a hint is meant to be. -->
    <color name="hint">#8b8e95</color>
    <!-- The own position on a map (1448): blue, as the maps people know
         draw it; 4.5:1 on the background. -->
    <color name="own_dot">#1a73e8</color>
</resources>
