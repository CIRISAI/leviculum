+void sx126x::diagPa(uint8_t *out) {
+  out[0] = lora_pa_model;
+  out[1] = diag_csd_first;
+  out[2] = diag_csd_mask;
+  out[3] = diag_detect_count;
+  out[4] = diag_begin_count;
+  out[5] = (diag_detect_ms >> 24) & 0xFF; out[6] = (diag_detect_ms >> 16) & 0xFF;
+  out[7] = (diag_detect_ms >> 8) & 0xFF;  out[8] = diag_detect_ms & 0xFF;
+  #if BOARD_MODEL == BOARD_HELTEC32_V4
+    out[9]  = digitalRead(LORA_PA_PWR_EN);
+    out[10] = digitalRead(LORA_PA_CSD);
+    out[11] = digitalRead(LORA_PA_CPS);
+    out[12] = digitalRead(LORA_PA_CTX);
+  #else
+    out[9] = out[10] = out[11] = out[12] = 0xFF;
+  #endif
+  out[13] = (uint8_t)lora_lna_gain;
+  uint8_t err[2] = {0};
+  executeOpcodeRead(OP_GET_DEVICE_ERRORS_DIAG, err, 2);
+  out[14] = err[0]; out[15] = err[1];
+  out[16] = readRegister(0x08AC); // RX gain: 0x94 power saving, 0x96 boosted
+}
