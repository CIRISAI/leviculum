+/* A real advertiser repeats its PDU every advertising interval, and a
+ * scanner hears it in any window that overlaps one. Without this the
+ * emulator reports a legacy advertiser only at the two enable instants
+ * above, so a scan window sees it only if it was advertising at the
+ * instant scanning was enabled.
+ */
+static unsigned int le_adv_interval_ms(const struct btdev *btdev)
+{
+	unsigned int interval;
+
+	/* Advertising parameters never set: 100 ms */
+	if (!btdev->le_adv_min_interval)
+		return 100;
+
+	/* Advertising_Interval_Min is in units of 0.625 ms, at least 20 ms */
+	interval = btdev->le_adv_min_interval * 5 / 8;
+	if (interval < 20)
+		interval = 20;
+
+	return interval;
+}
+
+static bool le_adv_broadcast(void *user_data)
+{
+	struct btdev *btdev = user_data;
+
+	/* Disabled by command, reset or connection since the last interval */
+	if (!btdev->le_adv_enable) {
+		btdev->le_adv_broadcast_id = 0;
+		return false;
+	}
+
+	le_set_adv_enable_complete(btdev);
+
+	return true;
+}
+
+static void le_adv_broadcast_stop(struct btdev *btdev)
+{
+	if (!btdev->le_adv_broadcast_id)
+		return;
+
+	timeout_remove(btdev->le_adv_broadcast_id);
+	btdev->le_adv_broadcast_id = 0;
+}
+
+static void le_adv_broadcast_start(struct btdev *btdev)
+{
+	le_adv_broadcast_stop(btdev);
+	btdev->le_adv_broadcast_id = timeout_add(le_adv_interval_ms(btdev),
+							le_adv_broadcast,
+							btdev, NULL);
+}
+
 static int cmd_set_adv_enable(struct btdev *dev, const void *data, uint8_t len)
 {
 	const struct bt_hci_cmd_le_set_ext_adv_enable *cmd = data;
@@ -3676,8 +3733,11 @@
 	cmd_complete(dev, BT_HCI_CMD_LE_SET_ADV_ENABLE, &status,
 						sizeof(status));
 
-	if (!status && dev->le_adv_enable)
+	if (!status && dev->le_adv_enable) {
 		le_set_adv_enable_complete(dev);
+		le_adv_broadcast_start(dev);
+	} else if (!dev->le_adv_enable)
+		le_adv_broadcast_stop(dev);
 
 	return 0;
 }
@@ -7382,6 +7442,8 @@
 	if (btdev->inquiry_id > 0)
 		timeout_remove(btdev->inquiry_id);
 
+	le_adv_broadcast_stop(btdev);
+
 	bt_crypto_unref(btdev->crypto);
 	del_btdev(btdev);
 
